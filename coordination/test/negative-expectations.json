    "params": { "type": "string" }
  },
  "short-sha.json": {
    "instancePath": "/dependencies/core/commit",
    "keyword": "pattern",
    "params": { "pattern": "^[0-9a-f]{40}$" }
  },
  "tag-name.json": {
    "instancePath": "/dependencies/core/commit",
    "keyword": "pattern",
    "params": { "pattern": "^[0-9a-f]{40}$" }
