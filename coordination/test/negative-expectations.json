  "missing-dependencies.json": {
    "instancePath": "",
    "keyword": "required",
    "params": { "missingProperty": "dependencies" }
  },
  "missing-dependency.json": {
    "instancePath": "/dependencies",
    "keyword": "required",
    "params": { "missingProperty": "core" }
  },
  "missing-repository.json": {
    "instancePath": "/dependencies/core",
    "keyword": "required",
    "params": { "missingProperty": "repository" }
  },
  "missing-schema-version.json": {
    "instancePath": "",
    "keyword": "required",
